# ── Python ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# ── Runtime / logs / temp ───────────────────────────────────────────────
*.log
*.swp
*.swo
*.tmp
*.bak
*~
.claude/settings.local.json*

# ── Build output (deb 는 /data 로 출력) ─────────────────────────────────
*.deb.build/

# ── infra_audit 실행 산출물 ─────────────────────────────────────────────
# 스크립트(infra_audit.sh / infra_remediate.sh / generate_pdf_report.sh /
# apply_security_patches.sh / .patches/definitions/)만 추적한다.
infra_audit/**/*_report_*
infra_audit/**/*_final_*
infra_audit/reports/
infra_audit/.patches/*_report/
infra_audit/tmp/

# 단, 조치 전 /etc 원본 스냅샷은 롤백·KISA 감사 증적이므로 추적을 유지한다.
# (`*.bak` 은 위에서 무시되지만 이미 index 에 있는 파일에는 영향 없음)
!infra_audit/**/backup_*/
*.log.[0-9]*
